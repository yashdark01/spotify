# Server
PORT=3001
NODE_ENV=development

# MongoDB — https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/music-player?retryWrites=true&w=majority

# Admin — Clerk account email allowed to use /api/admin routes
ADMIN_EMAIL=your-admin@email.com

# Cloudinary — https://cloudinary.com/console (admin song/album uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Clerk — https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
